# Copy this file to .env.local and fill in the values.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Bagrut generator (the only part that uses Claude).
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Teacher sign-in for the Word Quest portal and the Bagrut generator.
TEACHER_PASSWORD=choose-a-long-password
# Any long random text (at least 16 characters). Keeps sign-ins secure.
SESSION_SECRET=paste-a-long-random-string-here

# Word Quest classes (Supabase → Project Settings → API).
# Leave these out locally to use a file in .data/ instead.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
